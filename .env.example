# Kopier til .env og fyll inn ekte verdier før du kjører docker compose up.
# .env skal ALDRI committes til git.

# Vilkårlig lang, tilfeldig streng brukt til å signere innloggingstokens.
# Generer f.eks. med: openssl rand -hex 32
JWT_SECRET=

# Innloggingsopplysninger for admin-kontoen (deg). Endre og restart
# tjenesten (docker compose up -d --build api) for å bytte passord.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
